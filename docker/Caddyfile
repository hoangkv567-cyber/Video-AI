# Defaults to local HTTP. Set CADDY_ADDRESS to the real domain on the VPS;
# Caddy will then provision TLS automatically.
{$CADDY_ADDRESS::80} {
    reverse_proxy web:8000
    encode gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
    }
}
