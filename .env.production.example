# Copy to .env.production, replace every CHANGE_ME value, and never commit it.
VIDEOAI_ENV_FILE=.env.production
APP_ENV=production
SECRET_KEY=CHANGE_ME_RANDOM_48_OR_MORE_CHARACTERS
TOKEN_ENCRYPTION_KEY=CHANGE_ME_VALID_FERNET_KEY

CADDY_ADDRESS=video.example.com
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
PUBLIC_BASE_URL=https://video.example.com

POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
# URL-encode reserved characters in the password inside DATABASE_URL.
DATABASE_URL=postgresql+psycopg://videoai:CHANGE_ME_URL_ENCODED_DATABASE_PASSWORD@postgres:5432/videoai
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
# URL-encode reserved characters in the password inside REDIS_URL.
REDIS_URL=redis://:CHANGE_ME_URL_ENCODED_REDIS_PASSWORD@redis:6379/0

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS
MINIO_SECRET_KEY=CHANGE_ME_STRONG_MINIO_SECRET
MINIO_BUCKET=videoai
MINIO_SECURE=false

GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.7-flash
GEMINI_TEXT_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash
GROQ_API_KEY=
GROQ_ORPHEUS_TERMS_ACCEPTED=false
VIDEO_PROVIDER=keyframe_motion
IMAGE_PROVIDER=procedural
TTS_PROVIDER_EN=edge
TTS_PROVIDER_VI=edge
CAPTION_TIMING_PROVIDER=estimate
GOOGLE_TTS_API_KEY=

COST_HARD_CAP_USD=6.0
TIMEZONE_DISPLAY=Asia/Ho_Chi_Minh

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
ZALO_APP_ID=
ZALO_APP_SECRET=
