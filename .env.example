# Copy to .env and fill in. Never commit real secrets.
APP_ENV=dev
SECRET_KEY=change-me-32-bytes-min
TOKEN_ENCRYPTION_KEY=  # Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CADDY_ADDRESS=:80       # production: video.example.com
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443

POSTGRES_PASSWORD=change-me-database-password
DATABASE_URL=postgresql+psycopg://videoai:change-me-database-password@postgres:5432/videoai
REDIS_URL=redis://redis:6379/0

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=videoai
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=videoai
MINIO_SECURE=false

# --- Free-tier stack (default) ---
# Gemini free tier: Flash text models + grounding allowance; Veo has NO free tier.
GEMINI_API_KEY=
# Groq free dev tier (no credit card): LLM, Whisper (caption timestamps), Orpheus TTS (EN only).
GROQ_API_KEY=
GROQ_ORPHEUS_TERMS_ACCEPTED=false

# Provider selection (defaults shown; see app/config.py)
VIDEO_PROVIDER=keyframe_motion   # keyframe_motion (free, FFmpeg Ken Burns) | veo (paid)
IMAGE_PROVIDER=gemini            # gemini (free quota) | procedural (offline FFmpeg cards, no key)
TTS_PROVIDER_EN=edge             # edge works immediately; groq requires accepted Orpheus terms
TTS_PROVIDER_VI=edge             # edge (free, no key) | google — Groq has no Vietnamese
CAPTION_TIMING_PROVIDER=estimate # estimate (free) | groq_whisper | tts_marks

# --- Paid options (only if switching off the free stack) ---
GOOGLE_TTS_API_KEY=           # dedicated Cloud TTS API key; do not reuse a Gemini key implicitly

# Model config is versioned in app/config.py (ModelConfig); override here if needed
GEMINI_TEXT_MODEL=gemini-3.7-flash
GEMINI_TEXT_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
VEO_MODEL_LITE=veo-3.1-lite-generate-preview
VEO_MODEL_FAST=veo-3.1-fast-generate-preview
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_LLM_MAX_COMPLETION_TOKENS=4096
GROQ_TTS_MODEL_EN=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE_EN=hannah
GROQ_WHISPER_MODEL=whisper-large-v3
EDGE_TTS_VOICE_VI=vi-VN-HoaiMyNeural

# Hard cost cap per creative in USD
COST_HARD_CAP_USD=6.0

# OAuth apps (leave blank until created in week 1)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
ZALO_APP_ID=
ZALO_APP_SECRET=

PUBLIC_BASE_URL=http://localhost:8080
TIMEZONE_DISPLAY=Asia/Ho_Chi_Minh

# Alibaba Cloud Model Studio (international) — wan2.7-i2v ($0.10/s 720P, 50s free quota)
WAN_API_KEY=
# VIDEO_PROVIDER=wan  # keyframe_motion (free) | veo | wan
